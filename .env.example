# Copy to `.env` on the server. Only the contact form (/api/contact) reads these.
# Note: PORT does NOT belong here — see DEPLOYMENT.md (set it in PM2 instead).

# ── Mail transport ────────────────────────────────────────────────────────────
# LOCAL → hand off to the server's own Postfix on 127.0.0.1:25 (production)
# SMTP  → authenticate against an external SMTP host (handy in development)
MAIL_TYPE=LOCAL

# Only read when MAIL_TYPE=SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your@gmail.com
MAIL_PASS=your_app_password

# ── Addresses ─────────────────────────────────────────────────────────────────
# "From" on the confirmation sent to whoever fills in the contact form.
# Postfix must be allowed to send as this address (and SPF/DKIM should cover it).
MAIL_FROM=hello@skriptura.net
MAIL_FROM_NAME=Skriptura

# Recipients of the inbound-inquiry alert, and blind copies of the confirmation
# that goes out once the visitor enters their code.
CONTACT_BCC=skriptura.net@gmail.com, rgnpcrz@gmail.com

# ── Contact form verification ─────────────────────────────────────────────────
# Key for the HMAC that protects stored verification codes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production: without it the app falls back to a per-process key, so
# every in-flight code dies on restart.
CONTACT_CODE_SECRET=

# Where skriptura.db lives. Defaults to <project>/data — override if the DB
# should sit outside the deployment (e.g. on a backed-up volume).
# DATA_DIR=/var/lib/skriptura
